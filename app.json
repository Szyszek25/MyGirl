{
  "expo": {
    "name": "MyGirl",
    "slug": "mygirl",
    "scheme": "mygirl",
    "version": "0.4.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF9FC",
    "primaryColor": "#D72B78",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pl.mygirl.app"
    },
    "android": {
      "package": "pl.mygirl.app",
      "adaptiveIcon": { "backgroundColor": "#FFF9FC" }
    },
    "plugins": [["expo-image-picker", {
      "photosPermission": "MyGirl używa wybranego zdjęcia do Twojego profilu. Zdjęcie zostaje na urządzeniu do czasu uruchomienia kont online.",
      "cameraPermission": false,
      "microphonePermission": false
    }]]
  }
}
