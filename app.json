{
  "expo": {
    "name": "Polka",
    "slug": "polka",
    "scheme": "polka",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF9FA",
    "primaryColor": "#CE0459",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#CE0459"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pl.polka.app",
      "buildNumber": "1",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#CE0459"
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Polka używa wybranego zdjęcia do Twojego profilu.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "pl.polka.app",
      "versionCode": 1,
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#CE0459"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#CE0459"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Polka używa wybranych zdjęć i filmów do profilu, Stories oraz postów.",
          "cameraPermission": "Polka używa aparatu, gdy tworzysz Story lub zdjęcie do posta.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Polka używa mikrofonu tylko wtedy, gdy nagrywasz wiadomość głosową.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B8325A",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ]
  }
}
